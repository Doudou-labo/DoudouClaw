
# CRM plaintext (never commit)
crm/data/*.json
crm/data/*.bak

# CRM encrypted data (personal) — keep local
crm/data/*.age

# Local secrets / creds
.credentials/
.secrets/

# OpenClaw caches / temp
.tmp-skillinfo/
.clawdhub/

# Local data mapping (can include identifiers)
data/crm_google_tasks_map.json

# Python
__pycache__/
*.pyc

# Local runtime backups (safe restore points)
backups/

# OpenClaw local config/sessions
.openclaw/

# Next.js second-brain app artifacts
second-brain-nextjs/node_modules/
second-brain-nextjs/.next/

# Runtime sync logs
memory/para-notion-sync-*.log

# ByteRover context-tree (auto-synced from ~/.brv/)
# Les fichiers sont versionnés mais pas les snapshots temporaires
.brv/**/.snapshot.json
.brv/**/*.tmp
.brv/**/*.bak
