
# CRM plaintext (never commit)
crm/data/*.json
crm/data/*.bak

# CRM encrypted data (personal) — keep local
crm/data/*.age

# Local secrets / creds
.credentials/
.secrets/

# OpenClaw caches / temp
.tmp-skillinfo/
.clawdhub/

# Local data mapping (can include identifiers)
data/crm_google_tasks_map.json

# Python
__pycache__/
*.pyc

# Local runtime backups (safe restore points)
backups/

# OpenClaw local config/sessions
.openclaw/

# Second-brain generated index (rebuildable)
second-brain/data.json

# Runtime sync logs
memory/para-notion-sync-*.log
