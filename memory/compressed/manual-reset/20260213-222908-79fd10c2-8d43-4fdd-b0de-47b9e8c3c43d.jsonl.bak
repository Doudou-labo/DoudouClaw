ONEXT:DSY\",\"EURONEXT:EL\",\"EURONEXT:EN\",\"EURONEXT:ENGI\",\"EURONEXT:ERF\",\"EURONEXT:GLE\",\"EURONEXT:HO\",\"EURONEXT:KER\",\"EURONEXT:LR\",\"EURONEXT:MC\",\"EURONEXT:ML\",\"EURONEXT:MT\",\"EURONEXT:ORA\",\"EURONEXT:OR\",\"EURONEXT:PUB\",\"EURONEXT:RI\",\"EURONEXT:RMS\",\"EURONEXT:RNO\",\"EURONEXT:SAF\",\"EURONEXT:SAN\",\"EURONEXT:SGO\",\"EURONEXT:SLB\",\"EURONEXT:STLAP\",\"EURONEXT:SU\",\"EURONEXT:SW\",\"EURONEXT:TEP\",\"EURONEXT:TTE\",\"EURONEXT:VIE\",\"EURONEXT:VIV\",\"EURONEXT:WLN\"]\n# DAX 40 tickers\nDAX=[\"XETR:ADS\",\"XETR:AIR\",\"XETR:ALV\",\"XETR:BAS\",\"XETR:BAYN\",\"XETR:BEI\",\"XETR:BMW\",\"XETR:BNR\",\"XETR:CBK\",\"XETR:CON\",\"XETR:DB1\",\"XETR:DBK\",\"XETR:DHL\",\"XETR:DTG\",\"XETR:DTE\",\"XETR:EOAN\",\"XETR:FRE\",\"XETR:HEN3\",\"XETR:HFG\",\"XETR:IFX\",\"XETR:MBG\",\"XETR:MRK\",\"XETR:MTX\",\"XETR:MUV2\",\"XETR:PAH3\",\"XETR:P911\",\"XETR:QIA\",\"XETR:RHM\",\"XETR:RWE\",\"XETR:SAP\",\"XETR:SRT3\",\"XETR:SIE\",\"XETR:SHL\",\"XETR:SY1\",\"XETR:VNA\",\"XETR:VOW3\",\"XETR:ZAL\"]\n\nurl='https://scanner.tradingview.com/global/scan'\n\ndef fetch(tickers):\n    payload={\"symbols\":{\"tickers\":tickers,\"query\":{\"types\":[]}},\"columns\":[\"name\",\"description\",\"close\",\"change\"]}\n    r=requests.post(url,json=payload,timeout=20)\n    r.raise_for_status()\n    data=r.json().get('data',[])\n    rows=[]\n    for it in data:\n        s=it['s']; name,desc,close,chg=it['d']\n        rows.append((s,name,desc,close,chg))\n    return rows\n\ncac_rows=fetch(cac)\ndax_rows=fetch(DAX)\n\nfor label,rows in [('CAC',cac_rows),('DAX',dax_rows)]:\n    print('\\n'+label+' COUNT',len(rows))\n    s=sorted(rows,key=lambda x:x[4],reverse=True)\n    print('TOP5')\n    for r in s[:5]:\n        print(r[1],r[2],r[3],r[4])\n    print('BOTTOM5')\n    for r in s[-5:]:\n        print(r[1],r[2],r[3],r[4])\n\n# Michelin\nml=fetch([\"EURONEXT:ML\"])\nprint('\\nMICHELIN',ml)\nPY"},"partialJson":"{\"command\":\"python3 - <<'PY'\\nimport requests, json\\n\\n# CAC 40 tickers (TradingView/Euronext codes)\\ncac = [\\\"EURONEXT:ACA\\\",\\\"EURONEXT:AI\\\",\\\"EURONEXT:AIR\\\",\\\"EURONEXT:ALO\\\",\\\"EURONEXT:BNP\\\",\\\"EURONEXT:CA\\\",\\\"EURONEXT:CAP\\\",\\\"EURONEXT:CS\\\",\\\"EURONEXT:DG\\\",\\\"EURONEXT:DSY\\\",\\\"EURONEXT:EL\\\",\\\"EURONEXT:EN\\\",\\\"EURONEXT:ENGI\\\",\\\"EURONEXT:ERF\\\",\\\"EURONEXT:GLE\\\",\\\"EURONEXT:HO\\\",\\\"EURONEXT:KER\\\",\\\"EURONEXT:LR\\\",\\\"EURONEXT:MC\\\",\\\"EURONEXT:ML\\\",\\\"EURONEXT:MT\\\",\\\"EURONEXT:ORA\\\",\\\"EURONEXT:OR\\\",\\\"EURONEXT:PUB\\\",\\\"EURONEXT:RI\\\",\\\"EURONEXT:RMS\\\",\\\"EURONEXT:RNO\\\",\\\"EURONEXT:SAF\\\",\\\"EURONEXT:SAN\\\",\\\"EURONEXT:SGO\\\",\\\"EURONEXT:SLB\\\",\\\"EURONEXT:STLAP\\\",\\\"EURONEXT:SU\\\",\\\"EURONEXT:SW\\\",\\\"EURONEXT:TEP\\\",\\\"EURONEXT:TTE\\\",\\\"EURONEXT:VIE\\\",\\\"EURONEXT:VIV\\\",\\\"EURONEXT:WLN\\\"]\\n# DAX 40 tickers\\nDAX=[\\\"XETR:ADS\\\",\\\"XETR:AIR\\\",\\\"XETR:ALV\\\",\\\"XETR:BAS\\\",\\\"XETR:BAYN\\\",\\\"XETR:BEI\\\",\\\"XETR:BMW\\\",\\\"XETR:BNR\\\",\\\"XETR:CBK\\\",\\\"XETR:CON\\\",\\\"XETR:DB1\\\",\\\"XETR:DBK\\\",\\\"XETR:DHL\\\",\\\"XETR:DTG\\\",\\\"XETR:DTE\\\",\\\"XETR:EOAN\\\",\\\"XETR:FRE\\\",\\\"XETR:HEN3\\\",\\\"XETR:HFG\\\",\\\"XETR:IFX\\\",\\\"XETR:MBG\\\",\\\"XETR:MRK\\\",\\\"XETR:MTX\\\",\\\"XETR:MUV2\\\",\\\"XETR:PAH3\\\",\\\"XETR:P911\\\",\\\"XETR:QIA\\\",\\\"XETR:RHM\\\",\\\"XETR:RWE\\\",\\\"XETR:SAP\\\",\\\"XETR:SRT3\\\",\\\"XETR:SIE\\\",\\\"XETR:SHL\\\",\\\"XETR:SY1\\\",\\\"XETR:VNA\\\",\\\"XETR:VOW3\\\",\\\"XETR:ZAL\\\"]\\n\\nurl='https://scanner.tradingview.com/global/scan'\\n\\ndef fetch(tickers):\\n    payload={\\\"symbols\\\":{\\\"tickers\\\":tickers,\\\"query\\\":{\\\"types\\\":[]}},\\\"columns\\\":[\\\"name\\\",\\\"description\\\",\\\"close\\\",\\\"change\\\"]}\\n    r=requests.post(url,json=payload,timeout=20)\\n    r.raise_for_status()\\n    data=r.json().get('data',[])\\n    rows=[]\\n    for it in data:\\n        s=it['s']; name,desc,close,chg=it['d']\\n        rows.append((s,name,desc,close,chg))\\n    return rows\\n\\ncac_rows=fetch(cac)\\ndax_rows=fetch(DAX)\\n\\nfor label,rows in [('CAC',cac_rows),('DAX',dax_rows)]:\\n    print('\\\\n'+label+' COUNT',len(rows))\\n    s=sorted(rows,key=lambda x:x[4],reverse=True)\\n    print('TOP5')\\n    for r in s[:5]:\\n        print(r[1],r[2],r[3],r[4])\\n    print('BOTTOM5')\\n    for r in s[-5:]:\\n        print(r[1],r[2],r[3],r[4])\\n\\n# Michelin\\nml=fetch([\\\"EURONEXT:ML\\\"])\\nprint('\\\\nMICHELIN',ml)\\nPY\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":5336,"output":927,"cacheRead":22400,"cacheWrite":0,"totalTokens":28663,"cost":{"input":0.009337999999999999,"output":0.012978,"cacheRead":0.00392,"cacheWrite":0,"total":0.026236}},"stopReason":"toolUse","timestamp":1771000582142}}
