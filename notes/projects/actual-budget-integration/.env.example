# Variables Actual Budget — Template
# ============================================================
# Copie ce fichier vers .env et remplis les valeurs.
# Ne JAMAIS commiter le fichier .env (déjà dans .gitignore).
# ============================================================

# URL du serveur Actual Budget
#   - Scripts locaux : http://localhost:5006
#   - Skill OpenClaw : http://actual:5006 (réseau Docker)
ACTUAL_SERVER_URL=http://localhost:5006

# Mot de passe du budget Actual (défini dans les settings du budget)
# IMPORTANT : change cette valeur !
ACTUAL_PASSWORD=CHANGE_MOI_IMMEDIATEMENT

# Sync ID du budget — à récupérer après création du premier budget
# Comment :
#   1. Ouvre https://actual.doudougen.xyz
#   2. Settings (⚙️) du budget → Sync ID
#   3. Copie la valeur ici
# ATTENTION : ne rien mettre d'autre ici avant d'avoir créé le budget
ACTUAL_SYNC_ID=CHANGE_MOI_APRES_CREATION_BUDGET
